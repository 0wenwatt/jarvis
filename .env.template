# ==================================================
# JARVIS DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==================================================
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is gitignored.
#
# ==================================================

# ==================================================
# 1. GITHUB TOKEN
# ==================================================
# Used for:
#   - code-server authentication (browser access)
#   - GitHub MCP server (real GitHub API access)
#
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:user, read:org
GITHUB_TOKEN=

# ==================================================
# 2. LLM API KEYS
# ==================================================

# Anthropic (recommended: claude-sonnet-4-6)
# https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# OpenAI
# https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Google Gemini (free tier available)
# https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=

# Groq (very fast & cheap)
# https://console.groq.com/keys
GROQ_API_KEY=

# Mistral
# https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# OpenRouter (optional, 200+ models)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local Ollama (optional, self-hosted)
OLLAMA_BASE_URL=http://localhost:11434

# ==================================================
# 3. PRIMARY MODEL SELECTION
# ==================================================
# Format: provider:model-name
# Examples:
#   anthropic:claude-sonnet-4-6  (best all-around)
#   google:gemini-2.0-flash      (free, fast)
#   groq:llama-3.1-405b          (very fast)
AGENT_MODEL=anthropic:claude-sonnet-4-6

# ==================================================
# 4. POSTGRESQL + APACHE AGE
# ==================================================
POSTGRES_HOST=postgres-age
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ==================================================
# 5. LOGFIRE OBSERVABILITY
# ==================================================
# Leave blank to disable (agent works without it).
# https://logfire-us.pydantic.dev → project settings → write token
LOGFIRE_TOKEN=
LOGFIRE_PROJECT=
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev

# ==================================================
# 6. TAILSCALE (OPTIONAL)
# ==================================================
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=

# ==================================================
# 7. CODE-SERVER FALLBACK PASSWORD
# ==================================================
# Used when GITHUB_TOKEN is not set.
CODE_SERVER_PASSWORD=changeme

# ==================================================
# 8. DOCKER
# ==================================================
DOCKER_HOST=unix:///var/run/docker.sock

# ==================================================
# 9. AGENT TUNING (OPTIONAL)
# ==================================================
AGENT_THINKING=medium
AGENT_BUDGET_USD=0
AGENT_MAX_CONTEXT=120000

# ==================================================
# 10. DEVELOPMENT FLAGS
# ==================================================
DEBUG=false
LOG_LEVEL=INFO

# ==================================================
# 11. RAG CONFIGURATION
# ==================================================
# Name of the Apache AGE property graph used for GraphRAG
RAG_GRAPH_NAME=jarvis_kg

# OpenAI embedding model for vectorRAG (1536-dim for text-embedding-ada-002,
# 3072-dim for text-embedding-3-large)
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIM=1536

# Number of results to retrieve for each RAG mode
RAG_TOP_K=5

# ==================================================
# 12. CRAWL4AI MCP (OPTIONAL)
# ==================================================
# Leave blank to run the local crawl4ai MCP server without auth.
# Set CRAWL4AI_BASE_URL if pointing to a remote/self-hosted Crawl4AI instance.
CRAWL4AI_API_TOKEN=
CRAWL4AI_BASE_URL=
