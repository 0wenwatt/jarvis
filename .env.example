# Local environment values (do not commit)
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default model
AGENT_MODEL=anthropic:claude-sonnet-4-6

# PostgreSQL
POSTGRES_HOST=postgres-age
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional observability/remote access
LOGFIRE_TOKEN=
LOGFIRE_PROJECT=
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev
TAILSCALE_AUTHKEY=

# Crawl4AI MCP (optional — leave blank to use local crawl4ai without auth)
CRAWL4AI_API_TOKEN=
CRAWL4AI_BASE_URL=

# Optional local auth fallback
CODE_SERVER_PASSWORD=change-me

# Runtime flags
DOCKER_HOST=unix:///var/run/docker.sock
DEBUG=false
LOG_LEVEL=INFO
VERBOSE_AGENT_OUTPUT=false