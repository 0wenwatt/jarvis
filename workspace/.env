# ==================================================
# JARVIS DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==================================================
# 
# Copy this file to .env and fill in your actual values.
# NEVER commit this file to git; it contains secrets.
#
# To use multiple environments, create:
#   .env.local       (local development - .gitignore'd)
#   .env.production  (production - store securely)
#
# ==================================================

# ==================================================
# 1. GITHUB OAUTH
# ==================================================
# Used for:
#   - code-server authentication (browser access)
#   - Tailscale authentication (if available)
#
# Generate at: https://github.com/settings/tokens
# Required scope: read:user
GITHUB_TOKEN=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

# ==================================================
# 2. LLM API KEYS — MULTIPLE PROVIDERS
# ==================================================
# The agent supports 5 different LLM providers.
# You can use ONE primary or MIX & MATCH (agent picks best fit).
#
# See MODEL_SELECTION.md for detailed usage instructions.

# --- ANTHROPIC (Recommended as primary) ---
# Models: claude-sonnet-4-6, claude-opus-4-1, claude-haiku-4-5-20251001
# Get key: https://console.anthropic.com/keys
# Pricing: https://www.anthropic.com/pricing
ANTHROPIC_API_KEY=sk-ant-

# --- OPENAI ---
# Models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Get key: https://platform.openai.com/account/api-keys
# Pricing: https://openai.com/pricing
OPENAI_API_KEY=sk-

# --- GOOGLE GEMINI (NEW) ---
# Models: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
# Get key: https://aistudio.google.com/app/apikeys
# Pricing: https://ai.google.dev/pricing (FREE tier available!)
# WARNING: Some Gemini models have restricted features; claude-sonnet-4-6 recommended if available
GEMINI_API_KEY=AQ.Ab8RN6Ir0zc0XUfCpNjBI7QHHVNqxKMC7r0D_ke5wjqtk_1beg

# --- GROQ (NEW) ---
# Models: llama-3.1-405b, mixtral-8x7b, gemma-7b
# Get key: https://console.groq.com/keys
# Pricing: https://groq.com/pricing/ (VERY FAST & CHEAP)
# Use for: Fast inference, quick iterations, cost-sensitive tasks
GROQ_API_KEY=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

# --- MISTRAL (NEW) ---
# Models: mistral-large-latest, mistral-medium-latest, mistral-small-latest
# Get key: https://console.mistral.ai/api-keys/
# Pricing: https://mistral.ai/technology/#pricing (Competitive pricing)
# Use for: European data residency, mid-range capability/cost
MISTRAL_API_KEY=

# --- OPTIONAL: OpenRouter (200+ model access) ---
# Models: Access to multiple providers via single endpoint
# Get key: https://openrouter.ai/keys
# Pricing: https://openrouter.ai/pricing
OPENROUTER_API_KEY=1gwPkOLOgeP2q8mgTZflelwRbRjPatnr

# --- OPTIONAL: Local Ollama (Free, self-hosted) ---
# Setup: https://ollama.ai/
# Models: llama2, mistral, neural-chat, etc. (run locally)
OLLAMA_BASE_URL=http://localhost:11434

# ==================================================
# 3. PRIMARY LLM MODEL SELECTION
# ==================================================
# Set which model the agent uses by default.
# Override per-query in the FastAPI UI.
#
# Recommended options:
#   anthropic:claude-sonnet-4-6        (Best all-around, recommended)
#   openai:gpt-4o                      (Fast, capable)
#   google:gemini-2.0-flash            (FREE, very fast)
#   groq:llama-3.1-405b                (Super fast, cheap)
#   mistral:mistral-large-latest       (European alternative)
#
# Format: provider:model-name
# Full list: See MODEL_SELECTION.md

AGENT_MODEL=google:gemini-2.0-flash

# ==================================================
# 4. POSTGRESQL + APACHE AGE CONNECTION
# ==================================================
# The jarvis-dev container connects to the existing postgres-age container
# via Docker network 'jarvis-net'. These credentials authenticate to the DB.
#
# Host: postgres-age (DNS resolution via jarvis-net bridge)
# Port: 5432 (standard PostgreSQL)
#
# To find your database name, user, and password:
#   docker inspect postgres-age
#   or check your postgres-age setup documentation

POSTGRES_HOST=postgres-age
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=owen
POSTGRES_PASSWORD=Wattenbergh1!

# Optional: Connection string (alternative to above)
# DATABASE_URL=postgresql://user:password@postgres-age:5432/dbname

# ==================================================
# 5. LOGFIRE OBSERVABILITY
# ==================================================
# Pydantic Logfire traces all agent runs, tool calls, and WebSocket events.
#
# Project: 0wenwatt/jarvis-graph-agent (as requested)
# Base URL: https://logfire-us.pydantic.dev (US instance)
# Docs: https://pydantic.dev/docs/logfire/get-started/
#
# To generate a write token:
#   1. Go to https://logfire-us.pydantic.dev
#   2. Sign in
#   3. Navigate to project settings
#   4. Generate a new write token
#
# Leave blank to disable Logfire (agent will work without it)

LOGFIRE_TOKEN=pylf_v2_us_7ba38f8d-5e1b-48a9-bdda-c057717ebf70_vn3B7DRgXXT3bfLPHpdghm4KmFrQmbL0Rl778vlQdzHT
LOGFIRE_PROJECT=0wenwatt/jarvis-graph-agent
LOGFIRE_BASE_URL=https://logfire-us.pydantic.dev

# ==================================================
# 6. TAILSCALE (OPTIONAL - REMOTE ACCESS)
# ==================================================
# Tailscale creates a secure tunnel so you can access the container from
# any device on your Tailscale network (even outside your home network).
#
# Once running, you can SSH and access code-server from any Tailscale node.
#
# To generate an auth key:
#   1. Go to https://login.tailscale.com/admin/settings/keys
#   2. Click "Generate auth key..."
#   3. Copy the key (looks like: tskey-xxxxx)
#   4. Paste below
#
# Leave blank to disable Tailscale

TAILSCALE_AUTHKEY=tskey-auth-khqEgN6Uq321CNTRL-33b5bnSW8zGvFgRQQoV9zGbPKhSU4pktL

# ==================================================
# 7. CODE-SERVER
# ==================================================
# GitHub token is preferred for authentication (pulls from GITHUB_TOKEN above).
# This is a fallback password if GitHub token auth fails or is not configured.
#
# Can be any strong password; not used if GITHUB_TOKEN is set.

CODE_SERVER_PASSWORD=Wattenbergh1!

# ==================================================
# 8. DOCKER-IN-DOCKER
# ==================================================
# The agent can spawn sandboxed containers for code execution, testing, etc.
# This is configured automatically via /var/run/docker.sock mount.
#
# Verify it works:
#   docker exec jarvis-dev docker ps
#
# No configuration needed unless using a custom Docker socket path.

DOCKER_HOST=unix:///var/run/docker.sock

# ==================================================
# 9. SSH (OPTIONAL - TEMPORARY)
# ==================================================
# Allows container to SSH back to your Windows host for file access.
# This is TEMPORARY and will be replaced by Tailscale remoting once deployed to Proxmox VM.
#
# Your Windows username (used for SSH authentication)
# Example: SSH_HOST_USER=owen

SSH_HOST_USER=owen

# ==================================================
# 10. AGENT CONFIGURATION (OPTIONAL)
# ==================================================
# Fine-tune agent behavior

# Extended thinking level (minimal, low, medium, high, xhigh)
# Only supported by Anthropic (claude-sonnet-4-6)
AGENT_THINKING=medium

# Budget limit (in USD; agent stops if exceeded)
AGENT_BUDGET_USD=0

# Max context window before summarization (tokens)
AGENT_MAX_CONTEXT=120000

# ==================================================
# 11. DEVELOPMENT FLAGS (OPTIONAL)
# ==================================================
# Set to true to enable debugging/logging

DEBUG=false
LOG_LEVEL=INFO
VERBOSE_AGENT_OUTPUT=false

# ==================================================
# QUICK FILL-IN GUIDE
# ==================================================
#
# MINIMUM SETUP (works immediately):
#   1. GITHUB_TOKEN=<your github token>
#   2. Pick ONE LLM provider:
#      - ANTHROPIC_API_KEY=<your key> (recommended, most capable)
#      - GEMINI_API_KEY=<your key> (free!)
#      - GROQ_API_KEY=<your key> (fastest)
#      - MISTRAL_API_KEY=<your key> (european alternative)
#      - OPENAI_API_KEY=<your key>
#   3. POSTGRES_HOST=postgres-age (don't change)
#   4. POSTGRES_DB=<your database>
#   5. POSTGRES_USER=<your user>
#   6. POSTGRES_PASSWORD=<your password>
#
# RECOMMENDED SETUP (all features):
#   1. All of above
#   2. AGENT_MODEL=anthropic:claude-sonnet-4-6
#   3. LOGFIRE_TOKEN=<your token>
#   4. TAILSCALE_AUTHKEY=<your key>
#   5. Add backup providers:
#      - OPENAI_API_KEY=<for gpt-4o fallback>
#      - GROQ_API_KEY=<for fast inference>
#
# FULL SETUP (maximize flexibility):
#   1-5 above
#   2. Fill ALL five LLM keys (anthropic, openai, gemini, groq, mistral)
#   3. See MODEL_SELECTION.md for how to switch models at runtime
#
# ==================================================

# ==================================================
# MODEL SELECTION EXAMPLES
# ==================================================
#
# Set AGENT_MODEL to one of these (must have corresponding API key set):
#
# ANTHROPIC (Recommended):
#   AGENT_MODEL=anthropic:claude-sonnet-4-6       (Best all-around)
#   AGENT_MODEL=anthropic:claude-opus-4-1         (Most capable)
#   AGENT_MODEL=anthropic:claude-haiku-4-5        (Fastest)
#
# OPENAI:
#   AGENT_MODEL=openai:gpt-4o                     (Latest & capable)
#   AGENT_MODEL=openai:gpt-4-turbo                (Cheaper than gpt-4o)
#   AGENT_MODEL=openai:gpt-3.5-turbo              (Budget option)
#
# GOOGLE GEMINI (FREE!):
#   AGENT_MODEL=google:gemini-2.0-flash           (Fast, multimodal)
#   AGENT_MODEL=google:gemini-1.5-pro             (More capable)
#   AGENT_MODEL=google:gemini-1.5-flash           (Budget)
#
# GROQ (VERY FAST & CHEAP):
#   AGENT_MODEL=groq:llama-3.1-405b               (Best quality)
#   AGENT_MODEL=groq:mixtral-8x7b                 (Balanced)
#   AGENT_MODEL=groq:gemma-7b                     (Small)
#
# MISTRAL (EUROPEAN):
#   AGENT_MODEL=mistral:mistral-large-latest      (Best quality)
#   AGENT_MODEL=mistral:mistral-medium-latest     (Balanced)
#   AGENT_MODEL=mistral:mistral-small-latest      (Budget)
#
# ==================================================

# ==================================================
# REFERENCE: What Gets Used Where
# ==================================================
#
# FastAPI app.py reads all of these and passes to the agent:
#   - ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY
#   - AGENT_MODEL (which one to use)
#   - POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD
#   - LOGFIRE_TOKEN, LOGFIRE_PROJECT, LOGFIRE_BASE_URL
#   - AGENT_THINKING, AGENT_BUDGET_USD, AGENT_MAX_CONTEXT
#
# code-server uses:
#   - GITHUB_TOKEN (preferred for auth)
#   - CODE_SERVER_PASSWORD (fallback)
#
# Tailscale daemon uses:
#   - TAILSCALE_AUTHKEY (if set at container startup)
#
# SSH (container → Windows) uses:
#   - SSH_HOST_USER (for connecting back to Windows host)
#
# ==================================================
